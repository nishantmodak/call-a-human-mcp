# call-a-human-mcp configuration
# Copy to .env and fill in your values.
# Set CALL_HUMAN_CHANNEL to one of: cli, slack, telegram

# Which channel to use for human notifications
CALL_HUMAN_CHANNEL=cli

# How long to wait for a human response before timing out (seconds)
CALL_HUMAN_TIMEOUT=300

# ── Slack ────────────────────────────────────────────────────────────────────
# Required when CALL_HUMAN_CHANNEL=slack
#
# Bot OAuth token (xoxb-...) — needs chat:write, channels:history scopes
SLACK_BOT_TOKEN=

# App-level Socket Mode token (xapp-...) — needs connections:write scope
SLACK_APP_TOKEN=

# Channel ID to post into (e.g. C1234567890)
SLACK_CHANNEL_ID=

# ── Telegram ─────────────────────────────────────────────────────────────────
# Required when CALL_HUMAN_CHANNEL=telegram
#
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Chat or group ID to post into (use a negative ID for groups, e.g. -100123456789)
TELEGRAM_CHAT_ID=
